# MAKERS environment variables — NAMES ONLY. Never put real values in this file.
# Copy to .env.local for local development:  cp .env.example .env.local
# .env.local is git-ignored. Set production values in Vercel → Project → Settings → Environment Variables.
# Anything starting with NEXT_PUBLIC_ is visible in the browser: never put a secret in one.

# --- Site (needed from Phase 0) ---
# Public base URL of the site. Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database: Neon Postgres via the Vercel Marketplace (Phase 1) ---
# Pooled connection string, used by the running app.
DATABASE_URL=
# Direct (unpooled) connection string, used only for running migrations.
DATABASE_URL_UNPOOLED=
# Set to true only when you deliberately want sample draft products seeded.
SEED_SAMPLE_PRODUCTS=false

# --- Payments: Razorpay, TEST MODE keys only until the owner approves live mode (Phase 3) ---
# Checkout opens only when all three are set, the key starts with rzp_test_, and the site is NOT
# Vercel Production (set them for Preview and local only). Otherwise paid products show "Opens soon".
# Razorpay key ID (starts with rzp_test_). The server sends it to Checkout; no NEXT_PUBLIC_ copy needed.
RAZORPAY_KEY_ID=
# Razorpay key secret. SECRET — server only.
RAZORPAY_KEY_SECRET=
# Secret you choose in the Razorpay webhook settings. SECRET — server only.
RAZORPAY_WEBHOOK_SECRET=
# Keep false until Razorpay international payments are confirmed for the account.
NEXT_PUBLIC_ENABLE_USD=false

# --- Private file storage: any S3-compatible bucket (Phase 2) ---
# Current provider: Backblaze B2 (free 10 GB). The bucket must be PRIVATE; files are only reached through 60-second signed links.
# B2:  STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com   STORAGE_REGION=<region, e.g. us-west-004>
# R2 (alternative): STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_REGION=
# Application key ID limited to the one bucket. SECRET — server only.
STORAGE_ACCESS_KEY_ID=
# Application key secret. SECRET — server only.
STORAGE_SECRET_ACCESS_KEY=
# Name of the PRIVATE bucket that holds product files.
STORAGE_BUCKET=
# Base URL for PUBLIC preview assets only (covers, sample images). Never paid files. Not used yet.
R2_PUBLIC_BASE_URL=

# --- Email: Resend (Phase 2) ---
# Resend API key. SECRET — server only.
RESEND_API_KEY=
# Sender, e.g. "Store Name <hello@your-domain>" — owner decision, domain must be verified.
# Without a verified domain, Resend's test sender "onboarding@resend.dev" only delivers to the Resend account's own email.
# Local development without RESEND_API_KEY prints sign-in links to the terminal instead of sending them.
EMAIL_FROM=
# Address customers can write to for help — owner decision.
SUPPORT_EMAIL=

# --- Sessions and login (Phases 2 and 4) ---
# Long random string (32+ characters) that signs session cookies. SECRET — server only.
# Make one with:  openssl rand -base64 48
SESSION_SECRET=
# The single owner's admin email.
ADMIN_EMAIL=
# Hash of the owner's admin password (never the password itself). SECRET — server only.
# Make it with:  npm run admin:hash
ADMIN_PASSWORD_HASH=
# Long random string (32+ characters) used for magic-link tokens. SECRET — server only.
# Make one with:  openssl rand -base64 48  (use a different value from SESSION_SECRET)
MAGIC_LINK_SECRET=

# --- Rate limiting: Upstash Redis (Phase 2) ---
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
# Local development without these uses an in-memory limiter; deployed sites refuse requests (503) until set.
# Upstash REST URL.
UPSTASH_REDIS_REST_URL=
# Upstash REST token. SECRET — server only.
UPSTASH_REDIS_REST_TOKEN=

# --- Optional bot protection: Cloudflare Turnstile ---
# Turnstile site key (safe in the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key. SECRET — server only.
TURNSTILE_SECRET_KEY=

# --- Optional analytics ---
# Plausible domain, only if you use Plausible. Vercel Analytics needs no variable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
